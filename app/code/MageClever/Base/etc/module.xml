<?xml version="1.0"?>
<!--
/**
 * MageClever_Base — foundation module.
 * Sequenced after Magento_Cms/Store/Theme so data patches that create
 * CMS blocks and the ViewModels resolving them load in the right order.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="MageClever_Base">
        <sequence>
            <module name="Magento_Cms"/>
            <module name="Magento_Store"/>
            <module name="Magento_Theme"/>
        </sequence>
    </module>
</config>
